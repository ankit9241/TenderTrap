# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/
MONGODB_DB_NAME=tendertrap

# Server Port (optional, defaults to 3000 locally, provided by Render in production)
PORT=8080

# Client API Base URL (required for frontend extraction client)
VITE_API_BASE_URL=http://localhost:8080

# LLM Provider Configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:latest

# OCR Fallback Configuration (optional, safe defaults provided)
# OCR_LANG_PATH=./tessdata
# MAX_OCR_PAGES=15
# OCR_PAGE_TIMEOUT_MS=15000
# OCR_TOTAL_BUDGET_MS=60000

